# Copie este arquivo para ".env" e preencha. NUNCA suba o ".env" para o Git nem cole as chaves em chats.

PORT=3001
FRONTEND_URL=http://localhost:5173

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pierre

# Assinatura dos tokens de login (use um valor longo e aleatório)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# OpenAI (chat)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Pluggy (Open Finance) - credenciais em https://dashboard.pluggy.ai
OPEN_FINANCE_BASE_URL=https://api.pluggy.ai
OPEN_FINANCE_CLIENT_ID=
OPEN_FINANCE_CLIENT_SECRET=

# WhatsApp (W-API, https://docs.w-api.app): código de cadastro e avisos dos agentes
# Instância e token ficam no painel da W-API. Use um chip só para isso.
WHATSAPP_API_URL=https://api.w-api.app
WHATSAPP_INSTANCE_ID=
WHATSAPP_TOKEN=
# Avisos dos agentes por WhatsApp rodam sozinhos quando a W-API está configurada; "off" desliga
# AGENTS_SCHEDULER=off

# Em desenvolvimento o código de verificação também aparece no console do servidor.
# Com a W-API configurada ele é enviado de verdade; em produção ela é obrigatória.
NODE_ENV=development
